# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GROQ_API_KEY: Optional. When set, Groq handles chat, problem solver, flashcards,
# notes and voice transcription. Get one at https://console.groq.com/keys
GROQ_API_KEY=""
# Optional: override the Groq chat model.
GROQ_MODEL="llama-3.3-70b-versatile"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional: where teacher accounts, classes and uploaded files are stored (default ./data).
# On hosts with ephemeral disks (e.g. Cloud Run) point this at a persistent volume.
DATA_DIR="./data"
# Optional: secret for teacher login tokens (a random one is generated and saved if unset).
AUTH_SECRET=""
